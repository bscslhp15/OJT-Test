{
  "name": "testsite/yii2-backend",
  "description": "TestSite Yii2 backend API",
  "type": "project",
  "require": {
    "php": ">=7.2",
    "yiisoft/yii2": "~2.0.45",
    "yidas/yii2-composer-bower-skip": "*",
    "phpmailer/phpmailer": "^7.1"
  },
  "autoload": {
    "psr-4": {
      "app\\": ""
    }
  },
  "config": {
    "process-timeout": 1800,
    "allow-plugins": {
      "yidas/yii2-composer-bower-skip": true,
      "yiisoft/yii2-composer": true
    }
  }
}
